{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"takumi-unso",
  "main":"worker/index.js",
  "compatibility_date":"2026-10-30",
  "workers_dev":true,
  "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"404-page","html_handling":"auto-trailing-slash","run_worker_first":true},
  "d1_databases":[{"binding":"DB","database_name":"takumi-unso-cms","database_id":"f90618df-80d4-48a8-b574-e026d89cf73b","migrations_dir":"migrations"}],
  "observability":{"enabled":true}
}
